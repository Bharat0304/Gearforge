generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid()) 
  email String @unique
  name String? 
  password String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects Project[]
}
model Project{
  id String @id @default(uuid()) 
  name String 
  description String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String 
  user User @relation(fields: [userId], references: [id])
  tasks Task[]
  generations Generation[] 
}
model Task{
  id String @id @default(uuid()) 
  name String 
  description String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String 
  project Project @relation(fields: [projectId], references: [id])
}
model Generation{
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  prompt String
  generationid Jobs[]
  status Status @default(PENDING) 
 createdAt DateTime @default(now()) 
}

model Jobs{
  id String @id @default(uuid())
  generationId String 
  generation Generation @relation(fields: [generationId] , references: [id])
  error Boolean @default(false) 
    status Status @default(PENDING)
}
enum Status{
  PENDING 
  COMPLETED
}
model CodeSnippet{
  id String @id @default(uuid())
  code String  
  createdAt DateTime @default(now())
}
